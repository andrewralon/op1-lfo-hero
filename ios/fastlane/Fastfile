default_platform(:ios)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      duration: 1200,
      in_house: false
    )
  end

  desc "Sync certificates and provisioning profiles to ~/Library/MobileDevice"
  lane :certs do
    match(type: "development")
    match(type: "appstore")
  end

  desc "Capture App Store screenshots on simulators"
  lane :screenshots do
    capture_screenshots(
      project: "op1-lfo-hero.xcodeproj",
      scheme: "op1-lfo-hero",
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      skip_open_summary: true,
      html_template: "./fastlane/screenshots_template.html.erb"
    )
    frame_screenshots(
      path: "./fastlane/screenshots"
    )
    sh("open ./screenshots/screenshots.html")
  end

  desc "Preview what the next beta changelog would look like"
  lane :whatif do
    commits = changelog_from_git_commits(
      merge_commit_filtering: "exclude_merges",
      pretty: "- %s"
    )
    UI.message(commits)
  end

  desc "Print commits since a beta build number: fastlane changelog since:7"
  lane :changelog do |options|
    since = options[:since] || UI.input("Since build number: ")
    notes = changelog_from_git_commits(
      between: ["beta/#{since}", "HEAD"],
      merge_commit_filtering: "exclude_merges",
      pretty: "- %s"
    )
    UI.message(notes)
  end

  desc "Build and upload to TestFlight"
  lane :beta do |options|
    match(type: "appstore", readonly: true)

    # Ask App Store Connect for the last uploaded build rather than trusting
    # the local .pbxproj: increment_build_number(xcodeproj:) only mutates the
    # file on disk, and nothing in this lane commits that change, so it
    # silently drifts behind whatever actually shipped (see beta/19 vs the
    # build 20 that went out without a matching commit or tag). An xcarg
    # override touches no file, so there's nothing to fall out of sync.
    next_build = latest_testflight_build_number(
      version: get_version_number(xcodeproj: "op1-lfo-hero.xcodeproj")
    ) + 1

    build_app(
      project: "op1-lfo-hero.xcodeproj",
      scheme: "op1-lfo-hero",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}"
    )
    commit_options = { merge_commit_filtering: "exclude_merges", pretty: "- %s" }
    commit_options[:between] = ["beta/#{options[:since]}", "HEAD"] if options[:since]
    commits = changelog_from_git_commits(commit_options)
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: <<~NOTES
        o hai, tester person
        -thanks for testing! pls bug me with your bugs. random comments are welcome.
        -there is no audio without connecting a device
        -ui functionality - does it do what you expect? slide, change, ...
        -does it look good? too big or small, skewed or morphed? non-round circle, ...
        -is anything weird? does anything *not* do what you expect?

        commits:
        #{commits}
      NOTES
    )
    add_git_tag(
      tag: "beta/#{next_build}"
    )
    push_git_tags
  end

  desc "Upload screenshots from fastlane/screenshots/ to App Store Connect (no capture)"
  lane :upload_screenshots do
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"
    deliver(
      skip_metadata: true,
      skip_binary_upload: true,
      sync_screenshots: true,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload screenshots and app previews together (no capture). Screenshots are replaced; overwrite:false keeps existing previews"
  lane :upload_media do |options|
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"
    begin
      deliver(
        skip_metadata: true,
        skip_binary_upload: true,
        sync_screenshots: true,
        overwrite_screenshots: true,
        # overwrite:false keeps the previews already on App Store Connect (deliver skips a file
        # whose checksum matches); the default deletes the previews in EVERY device set first.
        overwrite_preview_videos: options[:overwrite] != false && options[:overwrite] != "false",
        force: true,
        precheck_include_in_app_purchases: false
      )
    rescue FastlaneCore::Interface::FastlaneError => e
      # After the video uploads, deliver sets the preview's poster frame, and App Store Connect
      # rejects that ("Asset Not in Complete state! can't update Image!"). Likely cause (inferred
      # from the API, not documented): deliver waits for `video_url` to be non-nil, but App Store
      # Connect returns "" while the video is still processing (Apple says up to 24 hours), and
      # `assetDeliveryState` already reads COMPLETE, which only means the upload finished. A poster
      # image at the default 5 s exists anyway. Retrying for 5 minutes did not help (fastlane
      # 2.236.1 and 2.241.1). The video and the screenshots do arrive, so treat that one error as
      # a warning and set the poster frame in App Store Connect by hand. Any other error still
      # fails the lane.
      raise unless e.message.include?("Asset Not in Complete state")
      UI.important("Previews uploaded, but App Store Connect refused the poster frame; pick it in the web UI.")
    end
  end

  desc "Upload app preview videos from fastlane/app_previews/ to App Store Connect. overwrite:false keeps what is already there (deliver skips files whose checksum matches); the default deletes the previews in EVERY device set first, so it restarts Apple's processing for all of them"
  lane :previews do |options|
    begin
      deliver(
        skip_metadata: true,
        skip_screenshots: true,
        skip_binary_upload: true,
        overwrite_preview_videos: options[:overwrite] != false && options[:overwrite] != "false",
        precheck_include_in_app_purchases: false
      )
    rescue FastlaneCore::Interface::FastlaneError => e
      # Same poster-frame rejection as `upload_media`; the video itself arrives.
      raise unless e.message.include?("Asset Not in Complete state")
      UI.important("Previews uploaded, but App Store Connect refused the poster frame; pick it in the web UI.")
    end
  end

  desc "Full release: build + upload metadata + screenshots + submit for review"
  lane :release do |options|
    # `fastlane release build:29` submits a build that is already on App Store Connect (the one that
    # was tested on TestFlight) instead of building a new one. Without it, this builds the next
    # build number and uploads it.
    if options[:build]
      deliver(
        submit_for_review: true,
        automatic_release: true,
        skip_screenshots: true,
        skip_binary_upload: true,
        build_number: options[:build].to_s,
        force: true,
        precheck_include_in_app_purchases: false
      )
      next
    end

    match(type: "appstore", readonly: true)

    # See the note in the `beta` lane above — xcarg override, not
    # increment_build_number(xcodeproj:), so the build number can't drift
    # out of sync with what's actually on App Store Connect.
    next_build = latest_testflight_build_number(
      version: get_version_number(xcodeproj: "op1-lfo-hero.xcodeproj")
    ) + 1

    build_app(
      project: "op1-lfo-hero.xcodeproj",
      scheme: "op1-lfo-hero",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}"
    )
    # Screenshots and previews are uploaded separately (`upload_media` / `previews`) and are already
    # on App Store Connect. Without skip_screenshots this would append a second copy and go past
    # the 10-per-set limit. Previews are safe: deliver skips a file whose checksum is already there.
    deliver(
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
